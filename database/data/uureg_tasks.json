[
 {
  "sec": 1,
  "text": "Дотооддоо болон мэргэжлийн баг авчирч албан хаагчдадаа сургалт зохион байгуулах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Хүний нөөцөө яаралтай бүрдүүлэх, судалгаа хийх",
  "period": "07.09",
  "responsible": "Ц.Сансармаа",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Өргөдөл, гомдлын шийдвэрлэлтийн талаар иргэдтэй холбогдож, шийдвэрлэлтэд хяналт тавих",
  "period": "07.09",
  "responsible": "Ц.Сансармаа, Г.Эрдэнэбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Гэрээ байгуулаагүй агентлагуудтай яаралтай гэрээ байгуулах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Босоо удирдлагатай байгууллагуудын өргөдөл гомдлын шийдвэрлэлтэд хяналт тавьж ажиллах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа, Г.Эрдэнэбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Газрын харилцаа, барилга хот байгуулалтын газар, Сайншанд сумын өргөдөл гомдлын шийдвэрлэлтэд хяналт тавьж ажиллах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа, Г.Эрдэнэбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Архив, албан хэрэг хөтлөлт, өргөдөл гомдлын талаар сумдад цахимаар сургалт зохион байгуулах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа, Ч.Нандин-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Стандарт, хэмжил зүйн хэлтсийн ажлыг сайжруулах",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Агентлагуудын ажлыг сайжруулах, хяналт шалгалт хийж үр дүнг танилцуулах",
  "period": "07.09",
  "responsible": "АЗДТГ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Иргэдийн дэд бүтэц, бүтээн байгуулалттай холбогдолтой хүсэлтийг шийдвэрлэх",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Анагаах, Хөвсгөл сумын ЕБС, Зоорийн, Саран хөхөөгийн барилгын ажлуудыг эрчимжүүлэх, тогтмол хяналт тавьж, явцыг танилцуулах",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Саран хөхөө, шинэ баригдаж байгаа байрны замын талбайг нэн тэргүүнд хийж гүйцэтгэх",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Төрийн албан хаагчдын ёс зүйг анхаарч ажиллах",
  "period": "07.09",
  "responsible": "Ёс зүйн хороо",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Татварын нэг хувийн ажлын хэсгийг хуралдуулж мэдээлэл өгэх",
  "period": "07.09",
  "responsible": "Г.Март, Ц.Мөнх-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Фестивальд оролцох урлаг, соёлынхны судалгааг гаргаж танилцуулах",
  "period": "07.09",
  "responsible": "Н.Мөнхцэцэг",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Фестиваль хийх газарт хямд үнэтэй ариун цэврийн байгууламжийг судалж авах",
  "period": "07.09",
  "responsible": "Н.Бүрэнтэгш",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Фестивалийн ажилд хандив цуглуулах ажлыг хийж танилцуулах",
  "period": "07.09",
  "responsible": "Г.Март, Н.Бүрэнтэгш",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Сургууль, цэцэрлэгийн өвөлжилтийн бэлтгэл ажлыг хангах",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ, Н.Мөнхцэцэг",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Оюутны тэтгэлгийн журмыг танилцуулж, холбогдох ААН-үүдтэй холбогдох",
  "period": "07.09",
  "responsible": "Н.Мөнхцэцэг",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Сумдаас уул уурхайн тэтгэлгээр суралцаж байгаа оюутны судалгааг гаргаж танилцуулах",
  "period": "07.09",
  "responsible": "Н.Мөнхцэцэг",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Хүүхдийн фестивалийг асран хамгаалагчдыг хамруулан зохион байгуулах",
  "period": "07.09",
  "responsible": "Н.Мөнхцэцэг, О.Цасанцэцэг",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Фестиваль дээр эмэгтэйчүүдийн холбоо, залуучуудын холбоотой хамтран 1000 эмэгтэй, 1000 залуусыг хамруулах",
  "period": "07.09",
  "responsible": "Н.Мөнхцэцэг, Ш.Алимаа",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Босоо тэнхлэгийн зам дагуу газрын дуудлага худалдааг зохион байгуулах",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ, Л.Олзбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Сайншанд сумын хот төлөвлөлтийн ерөнхий төлөвлөгөө гаргаж, 3 замын орчимд дэд бүтцийн ажлыг хийж иргэдэд газар олгох төлөвлөлт хийх",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ, С.Одбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Чандмань-Илч ОНӨХК-ийн салбаруудыг хувийн хэвшилд шилжүүлэх",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ, Н.Бүрэнтэгш, Д.Мэндбаяр",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Дэнжийн хүү ХХК-ийн ажил гүйцэтгэх гэрээг цуцлах",
  "period": "07.09",
  "responsible": "Ц.Мөнх-Эрдэнэ, Ч.Нандин-Эрдэнэ",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 1,
  "text": "Хамтран ажиллах санал ирүүлсэн БНХАУ-ын мужтай уулзалт зохион байгуулах",
  "period": "07.09",
  "responsible": "Ц.Сансармаа, А.Номин",
  "collaborator": "АЗДТГ-ын дарга",
  "note": "",
  "sector": "",
  "indicator": "",
  "baseline": "",
  "target": ""
 },
 {
  "sec": 2,
  "text": "Сум бүрийн бэлчээрийн даацыг тодорхойлох",
  "period": "07.28-09.28",
  "responsible": "УЦУОШГазар",
  "collaborator": "ХХААГазар",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Бэлчээрийн даац тодорхойлох цэгийн тоо",
  "baseline": "74",
  "target": "74"
 },
 {
  "sec": 2,
  "text": "Байран болон нэмэгдэл тэжээлээр тэжээх малын тоог сум тус бүрээр гаргах",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Малын тоо",
  "baseline": "250",
  "target": "400"
 },
 {
  "sec": 2,
  "text": "Аймаг, сумын өвс тэжээлийн нөөцийн бэлэн байдлыг хангуулах",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Аймгийн өвс / Аймгийн тэжээл / Сумын өвс / Сумын тэжээл /тонн/",
  "baseline": "420 / 367,8 / 34,9",
  "target": "557 / 174 / 905 / 452"
 },
 {
  "sec": 2,
  "text": "Малын хашаа хорооны шинээр болон сэргээн засварласан хашаа",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Хашаа /тоо/",
  "baseline": "33",
  "target": "50"
 },
 {
  "sec": 2,
  "text": "Малчдын өвс тэжээлийн нөөцийн бэлэн байдлыг хангуулах",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Өвс / тэжээл /тонн/",
  "baseline": "1642 / 201",
  "target": "9045 / 4523"
 },
 {
  "sec": 2,
  "text": "Шинээр болон сэргээн засварласан бэлчээрийн худаг ус",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "тоо",
  "baseline": "21",
  "target": "24"
 },
 {
  "sec": 2,
  "text": "Отор нүүдлийн нарийвчилсан судалгааг гаргах /аймгаас гарах, орох/",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Өрх",
  "baseline": "538",
  "target": "575"
 },
 {
  "sec": 2,
  "text": "Ургацын урьдчилсан балансыг таримлын төрөл тус бүрээр нарийвчлан гаргах",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Га",
  "baseline": "208",
  "target": "346"
 },
 {
  "sec": 2,
  "text": "Ургац хураалтанд ажиллах хүн хүч, техникийн бэлтгэл, зохион байгуулалтын бэлэн байдал",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Ургац /тонн/ хүн хүч, техник хэрэгсэл /тоо/",
  "baseline": "756.9 / 402 / 121",
  "target": "8.01-нээс"
 },
 {
  "sec": 2,
  "text": "Төв суурин газрын хүн амын хаврын улирлын хэрэгцээнд шаардагдах махны нөөцийн тооцоог гаргах, нөөц бүрдүүлэх ажлыг зохион байгуулах",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Сумдын ЗДТГ",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Махны нөөц /тонн/",
  "baseline": "0",
  "target": "655.82"
 },
 {
  "sec": 2,
  "text": "Мах бэлтгэлх, нийлүүлэх, хадгалах, худалдах бүх шатанд цахим төлбөрийг олгох нөхцлийг бүрдүүлж хэрэгжилтэд хяналт тавих",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "Татварын хэлтэс",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Цахим төлбөрийн баримт олгох иргэн, аан-н тоо",
  "baseline": "0",
  "target": "9"
 },
 {
  "sec": 2,
  "text": "Мах бэлтгэлийн явц, хадгалалт, тээвэрлэлт, чанар аюулгүй байдлын шаардлагад хяналт тавих",
  "period": "07.28-09.28",
  "responsible": "ХХААГазар",
  "collaborator": "МЭГ, АТТөв",
  "note": "",
  "sector": "Хүнс, хөдөө аж ахуй",
  "indicator": "Хяналт шалгалтын тоо",
  "baseline": "1",
  "target": "3"
 },
 {
  "sec": 2,
  "text": "Мал амьтны шимэгчдэх өвчнөөс эмчлэн сэргийлэх арга хэмжээг зохион байгуулах",
  "period": "07.28-09.28",
  "responsible": "Мал эмнэлгийн газар",
  "collaborator": "",
  "note": "",
  "sector": "Мал эмнэлэг",
  "indicator": "Малын тоо /мян/",
  "baseline": "919.0",
  "target": "535.0"
 },
 {
  "sec": 2,
  "text": "Хонины цэцэг өвчнөөс урьдчилан сэргийлэх дархлаажуулалтын ажлыг зохион байгуулах",
  "period": "07.28-09.28",
  "responsible": "Мал эмнэлгийн газар",
  "collaborator": "",
  "note": "",
  "sector": "Мал эмнэлэг",
  "indicator": "Малын тоо /мян/",
  "baseline": "805",
  "target": "830.1"
 },
 {
  "sec": 2,
  "text": "Бог малын мялзан өвчнөөс урьдчилан сэргийлэх дархлаажуулалтын ажлыг зохион байгуулах",
  "period": "07.28-09.28",
  "responsible": "Мал эмнэлгийн газар",
  "collaborator": "",
  "note": "",
  "sector": "Мал эмнэлэг",
  "indicator": "Малын тоо /сая/",
  "baseline": "1.4",
  "target": "505.2 мян"
 },
 {
  "sec": 2,
  "text": "Бруцеллёз өвчнөөс урьдчилан сэргийлэх дархлаажуулалтын ажлыг зохион байгуулах",
  "period": "07.28-09.28",
  "responsible": "Мал эмнэлгийн газар",
  "collaborator": "",
  "note": "",
  "sector": "Мал эмнэлэг",
  "indicator": "Малын тоо /мян/",
  "baseline": "217.2",
  "target": "503.5"
 },
 {
  "sec": 2,
