{
    "manifest_version": 3,
    "name": "Manage Dornogovi",
    "short_name": "Manage Dornogovi",
    "description": "Дорноговь аймгийн нэгдсэн системд хадгалсан нэвтрэх мэдээллээр төрийн системүүдэд автоматаар нэвтэрнэ.",
    "version": "1.4.0",
    "key": "",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://manage.dornogovi.gov.mn/*",
        "http://manage.dornogovi.gov.mn/*",
        "http://localhost/*",
        "https://erp.e-mongolia.mn/*",
        "https://shilen.gov.mn/*",
        "https://www.gov.mn/*",
        "https://mail.gov.mn/*",
        "https://loginnew.unelgee.gov.mn/*",
        "http://dornogovi.unelgee.gov.mn/*",
        "https://dornogovi.unelgee.gov.mn/*",
        "https://sudalgaa.dornogovi.gov.mn/*",
        "https://dan.gov.mn/*",
        "https://*.dan.gov.mn/*",
        "https://auth.e-mongolia.mn/*"
    ],
    "externally_connectable": {
        "matches": [
            "https://manage.dornogovi.gov.mn/*",
            "http://manage.dornogovi.gov.mn/*",
            "http://localhost/*"
        ]
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Manage Dornogovi — тохиргоо",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://manage.dornogovi.gov.mn/*",
                "http://manage.dornogovi.gov.mn/*",
                "http://localhost/manage.dornogovi.gov.mn/*"
            ],
            "js": [
                "bridge.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://erp.e-mongolia.mn/*",
                "https://shilen.gov.mn/*",
                "https://www.gov.mn/*",
                "https://mail.gov.mn/*",
                "https://loginnew.unelgee.gov.mn/*",
                "http://dornogovi.unelgee.gov.mn/*",
                "https://dornogovi.unelgee.gov.mn/*",
                "https://sudalgaa.dornogovi.gov.mn/*",
                "https://auth.e-mongolia.mn/*"
            ],
            "js": [
                "autofill.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        },
        {
            "matches": [
                "https://dan.gov.mn/*",
                "https://*.dan.gov.mn/*",
                "https://auth.e-mongolia.mn/*"
            ],
            "js": [
                "dan-autofill.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}
