APP_NAME="Manage Dornogovi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://manage.dornogovi.gov.mn

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manage_dornogovi
DB_USERNAME=manage_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Хоосон — iPhone Safari "domain=null" эсвэл буруу domain-г хаядаг.
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
