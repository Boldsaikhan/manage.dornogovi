{
    "name": "manage-dornogovi-desktop",
    "productName": "Manage Dornogovi",
    "version": "1.0.0",
    "description": "Дорноговь аймгийн дотоод систем — Windows ширээний програм. Холбосон системүүд рүү автоматаар нэвтэрнэ.",
    "author": "Дорноговь аймгийн ЗДТГ",
    "main": "src/main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win --x64"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0"
    },
    "build": {
        "appId": "mn.gov.dornogovi.manage",
        "productName": "Manage Dornogovi",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "src/**/*",
            "!src/*-source.js"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.png",
            "artifactName": "Manage-Dornogovi-Setup.${ext}"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Manage Dornogovi",
            "allowToChangeInstallationDirectory": false,
            "differentialPackage": false
        },
        "compression": "maximum"
    }
}
